# Reality AI Backend Environment Variables
# Exact names per AGENTS.md cross-team specification — DO NOT RENAME

# PostgreSQL connection string with PostGIS and pgvector support
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reality_ai

# Secret key used for JWT authentication signing
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# PostgreSQL container configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=reality_ai
